{
  "name": "agent-sandbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",

  // Workaround for a Podman/netavark bug: an "internal: true" network's
  // FORWARD-accept rule only covers OTHER netavark networks, not itself —
  // so containers on the SAME internal network (workspace <-> proxy) get
  // silently dropped, even though internal:true's actual point (blocking
  // outbound WAN) works fine. The NETAVARK_FORWARD chain this needs to
  // patch only exists WHILE a container is attached to an internal
  // network — it's gone as soon as everything's stopped — so a plain
  // pre-up check (this used to be one) fails outright on a from-cold
  // start instead of no-op'ing, which broke every "Reopen in Container"
  // after containers had fully stopped.
  //
  // Fix: launch a short-lived, detached background watcher (already
  // provisioned at /root/.netfix.sh on the Podman machine VM — see
  // README) on the HOST before every container start. It polls for the
  // chain to appear as THIS "up" call creates it, patches the rule the
  // moment it does (usually ~1-2s), and self-terminates. initializeCommand
  // itself returns immediately either way, so it never blocks or fails
  // "up". "podman-machine-agentic" is this machine's Podman machine name
  // (check/adjust via `podman machine list` if that ever changes) —
  // there's no usable default machine name here.
  "initializeCommand": [
    "podman", "machine", "ssh", "podman-machine-agentic", "--",
    "nohup /root/.netfix.sh >/tmp/netfix.log 2>&1 & disown; exit 0"
  ],

  // Every proxy-aware CLI (npm, pip, git, curl, gh, claude) picks these up.
  "remoteEnv": {
    "HTTP_PROXY": "http://proxy:3128",
    "HTTPS_PROXY": "http://proxy:3128",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Runs once per container create. Add other agent-agnostic CLI installs here.
  // The chown is needed because Podman creates named volumes (claude-config,
  // gh-config) owned by root, but the container runs as the non-root vscode
  // user — without this, `claude login` / `gh auth login` fail with
  // "permission denied" writing into those mounted directories.
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.config/gh && npm install -g @anthropic-ai/claude-code && gh extension install github/gh-copilot || true",

  // Runs every time the container (re)starts — picks up the GitHub App
  // installation token the PROXY container mints and refreshes on its own
  // (see .devcontainer/proxy/gh-app-token-daemon.sh) and hands it to `gh`.
  // Baked into the image at build time (see Dockerfile), not read from
  // /workspace — .devcontainer/ isn't mounted there. Safe no-op if .env /
  // the key aren't set up yet, or the proxy hasn't minted a token yet.
  "postStartCommand": "gh-app-token.sh || true",

  "customizations": {
    "vscode": {
      // VS Code extensions (e.g. GitHub Copilot) run in an extension host
      // process that does NOT automatically inherit shell env vars, so the
      // proxy has to be set here too.
      "settings": {
        "http.proxy": "http://proxy:3128",
        "http.proxyStrictSSL": true,
        "http.proxySupport": "on"
      },
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
        // Add the Claude Code extension id here too if/when you use it —
        // verify the exact marketplace id before relying on it.
      ]
    }
  }
}
