{
  "name": "agent-sandbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",

  // Host-side setup that only matters for Podman (a netavark bug — see the
  // script for detail); a clean no-op under Docker. Keeping this logic in
  // its own script (rather than inline here) is what lets this one
  // devcontainer.json serve both engines — see README's "Using Docker
  // instead of Podman".
  "initializeCommand": [
    "powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
    "-File", ".devcontainer/scripts/host-initialize.ps1"
  ],

  // Every proxy-aware CLI (npm, pip, git, curl, gh, claude) picks these up.
  "remoteEnv": {
    "HTTP_PROXY": "http://proxy:3128",
    "HTTPS_PROXY": "http://proxy:3128",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  },

  "features": {
    // 22, not 20: the standalone GitHub Copilot CLI (@github/copilot, below)
    // requires Node 22+.
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Runs once per container create. Add other agent-agnostic CLI installs here.
  // The chown is needed because named volumes (claude-config, gh-config) get
  // created owned by root on both Podman and Docker, but the container runs
  // as the non-root vscode user — without this, `claude login` / `gh auth
  // login` fail with "permission denied" writing into those directories.
  // @github/copilot is the standalone GitHub Copilot CLI (an agentic
  // terminal tool, like claude-code) — separate from the `gh copilot`
  // extension right after it, which is the older suggest/explain-only tool.
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.config/gh && npm install -g @anthropic-ai/claude-code @github/copilot && gh extension install github/gh-copilot || true",

  // Runs every time the container (re)starts — picks up the GitHub App
  // installation token the PROXY container mints and refreshes on its own
  // (see .devcontainer/proxy/gh-app-token-daemon.sh) and hands it to `gh`.
  // Baked into the image at build time (see Dockerfile), not read from
  // /workspace — .devcontainer/ isn't mounted there. Safe no-op if .env /
  // the key aren't set up yet, or the proxy hasn't minted a token yet.
  "postStartCommand": "gh-app-token.sh || true",

  "customizations": {
    "vscode": {
      // VS Code extensions (e.g. GitHub Copilot) run in an extension host
      // process that does NOT automatically inherit shell env vars, so the
      // proxy has to be set here too.
      "settings": {
        "http.proxy": "http://proxy:3128",
        "http.proxyStrictSSL": true,
        "http.proxySupport": "on"
      },
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
        // Add the Claude Code extension id here too if/when you use it —
        // verify the exact marketplace id before relying on it.
      ]
    }
  }
}
