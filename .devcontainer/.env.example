# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Toolchain ---
# .NET SDK channel to install (e.g. 8.0, 9.0). Blank = 8.0 (see Dockerfile).
DOTNET_VERSION=

# --- GitHub App (dedicated identity for this agent's repo/PR/issue ops) ---
GH_APP_ID=
GH_APP_INSTALLATION_ID=
# Path on the HOST to the App's private key .pem — kept outside the repo.
GH_APP_PRIVATE_KEY_HOST_PATH=

# --- Claude Code auth: pick ONE ---
# Have a Claude subscription (Pro/Max)? Leave this blank and instead run
# `claude` once in the container's terminal and follow the login prompt —
# it's OAuth against your Claude.ai account, no key needed. The token is
# persisted in the `claude-config` volume, so it's a one-time step per
# volume (survives container rebuilds, not volume deletion).
#
# No subscription, or want a fully separate/headless identity for the agent
# (e.g. for others reusing this template, or CI-style unattended runs)?
# Create a dedicated Workspace + API key in the Anthropic Console instead
# and set it here — takes priority over any `claude login` session if both
# are present.
ANTHROPIC_API_KEY=
